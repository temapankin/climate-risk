\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textit  {Coefficient estimates for variables of interest across hedonic regression specifications.} \textit  {Note.} Points denote point estimates with 95\% confidence intervals. Gray circles represent the baseline OLS model; blue triangles represent the model with year fixed effects; dark blue squares represent the model with year and county fixed effects. The vertical dashed line at zero serves as a reference for null effects. Wide confidence intervals for the interaction terms reflect the small number of clustering units ($n = 4$ counties) rather than model misspecification.}}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:coefplot}{{5}{11}{\textit {Coefficient estimates for variables of interest across hedonic regression specifications.} \textit {Note.} Points denote point estimates with 95\% confidence intervals. Gray circles represent the baseline OLS model; blue triangles represent the model with year fixed effects; dark blue squares represent the model with year and county fixed effects. The vertical dashed line at zero serves as a reference for null effects. Wide confidence intervals for the interaction terms reflect the small number of clustering units ($n = 4$ counties) rather than model misspecification}{figure.caption.7}{}}
